# Zero — environment configuration
# Copy this file to .env.local and uncomment the lines you need.

# Database path — where your SQLite file lives.
# Default: data/zero.db (relative to the project root)
#
# macOS:
# ZERO_DB_PATH=~/Library/Application Support/Zero/zero.db
#
# Linux:
# ZERO_DB_PATH=~/.local/share/zero/zero.db
#
# Windows:
# ZERO_DB_PATH=%LOCALAPPDATA%\Zero\zero.db

# Extra origins allowed to reach the dev server (comma-separated host:port).
# Needed when opening the app from a phone, another LAN device, Tailscale, or
# a tunneled hostname. Origins listed here are applied to both Next.js's
# allowedDevOrigins (silences cross-origin dev warnings) and to server actions'
# allowedOrigins (so mutations don't get rejected).
#
# Examples:
# ALLOWED_DEV_ORIGINS=192.168.1.42:3000
# ALLOWED_DEV_ORIGINS=192.168.1.42:4040,macbook.tail-abcd.ts.net:4040
# ALLOWED_DEV_ORIGINS=zero.example.com

# Show a top "Dev mode" banner with the DB filename. Set to 1 on dev and
# staging instances so you can tell at a glance you're not on prod. Leave
# unset on production. NEXT_PUBLIC_ prefix is required so the value reaches
# the rendered HTML.
# NEXT_PUBLIC_ZERO_DEV_MODE=1

# Enable historical-data surfaces (pre-cutoff year selectors on the
# Insights page, audit-grid tab, historical_snapshot reads). Off by default
# because the schema is empty for a fresh install; set to 1 only if you
# have populated `historical_snapshot_entries`. Requires a rebuild.
# NEXT_PUBLIC_ZERO_HISTORICAL_DATA=1


# ── Self-hosting on a remote server (optional) ─────────────────────────────
# Only needed if Zero runs on another machine (a Raspberry Pi, home server, or
# VPS under pm2) and you use the deploy-remote / db-switch / import-txns agent
# skills or `npm run mirror` from your dev machine. (import-txns works
# without these — it falls back to the local DB.) Read by bin/remote-env.sh;
# a real environment variable wins over this file. Use absolute paths.
#
# ZERO_REMOTE_HOST=me@192.168.1.50        # ssh target, or an ~/.ssh/config alias
# ZERO_REMOTE_DIR=zero                    # server checkout (relative to ~ or absolute)
# ZERO_REMOTE_DB_PATH=/home/me/.local/share/zero/zero.db
# ZERO_REMOTE_BACKUP_DIR=/home/me/.local/share/zero/backups   # default: backups/ next to the DB
# ZERO_REMOTE_PM2_NAME=zero               # pm2 process deploys restart
# ZERO_REMOTE_URL=http://192.168.1.50:4040
#
# Git mirror for `npm run mirror` — a bare repo that keeps a second copy of
# every ref (see bin/mirror-push.sh for one-time setup).
# ZERO_MIRROR_URL=me@192.168.1.50:zero-mirror.git
