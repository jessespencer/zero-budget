{
  "name": "zero",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "build": "NEXT_BUILD_DIR=.next-prod next build",
    "start": "NEXT_BUILD_DIR=.next-prod next start -p 4040 --hostname 0.0.0.0",
    "start:test": "NEXT_BUILD_DIR=.next-prod next start -p 3000 --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "backup": "bash bin/backup.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "mirror": "bash bin/mirror-push.sh",
    "codex:sync": "node scripts/sync-codex-mirror.mjs",
    "db:info": "node scripts/db-info.mjs",
    "db:migrate": "node scripts/apply-pending-migrations.mjs",
    "db:slot": "node scripts/db-slot.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "site": "node scripts/serve-site.mjs",
    "site:assets": "node scripts/capture-site-assets.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:build": "next build --turbopack && E2E_USE_BUILD=1 playwright test",
    "deploy": "npm run build && pm2 restart zero || pm2 start npm --name zero -- start"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/figtree": "^5.2.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/better-sqlite3": "^7.6.13",
    "@types/sortablejs": "^1.15.9",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "next": "15.5.14",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-sortablejs": "^6.1.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
